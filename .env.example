# ================================
# Google Cloud Platform
# ================================
GCP_PROJECT_ID=medflow-referral-agent
GCP_REGION=europe-west3

# ================================
# Vertex AI
# ================================
VERTEX_AI_LOCATION=europe-west3
VERTEX_AI_MODEL=gemini-1.5-pro

# ================================
# LangSmith Observability
# ================================
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_PROJECT=medflow-referral-agent
LANGSMITH_TRACING=true

# ================================
# ChromaDB
# ================================
CHROMA_PERSIST_DIR=./data/chroma

# ================================
# BigQuery Audit Logging
# ================================
BIGQUERY_DATASET=medflow_logs
BIGQUERY_TABLE=referral_processing_logs
ENABLE_BIGQUERY=false

# ================================
# Application Settings
# ================================
ENVIRONMENT=development
LOG_LEVEL=INFO
MAX_RETRIES=3

# ================================
# Routing Thresholds
# ================================
ROUTING_CONFIDENCE_THRESHOLD=0.70
ROUTING_ACCURACY_THRESHOLD=0.90
URGENCY_ACCURACY_THRESHOLD=0.95